<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hf4all</groupId>
    <artifactId>hf4all-planner</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.hf4all.planner.Main</mainClass>
                        </manifest>
                    </archive>
                    <!-- Tools are one-shot CLIs that mutate the source-of-truth
                         JSON files. They live in the build for `mvn exec:java`
                         convenience but are NOT shipped in the runtime jar. -->
                    <excludes>
                        <exclude>com/hf4all/planner/tools/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Adds src/tools/java as an additional compile source. Tools sit
                 outside the production tree (src/main/java) so it's clear they
                 aren't part of the runtime, while still being on the compile
                 classpath when running `mvn exec:java -Dexec.mainClass=...`. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-tools-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/tools/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Runs JUnit 5 tests. Maven 3.9+ bundles Surefire 3.x, but pin
                 the version so builds don't drift with the local Maven install. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Whole-fork timeout. Bumped from 300 to 900 because the
                         JUnit-Jupiter parallel test config (in
                         src/test/resources/junit-platform.properties) packs
                         many integration tests into a single fork. -->
                    <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
                    <!-- Single fork; concurrency comes from JUnit Jupiter's
                         own parallel-execution config. Re-using the fork keeps
                         the @BeforeAll-loaded SolarMap singleton hot across
                         classes. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>

            <!-- `mvn exec:java@run` starts the server with the main classpath. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>run</id>
                        <configuration>
                            <mainClass>com.hf4all.planner.Main</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
